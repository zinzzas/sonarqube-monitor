{
  "version": 2,
  "defaultProfile": "vue_src_tree",
  "defaults": {
    "chartStackUnmappedBucket": "unknown",
    "chartModuleMaxDepth": 3,
    "moduleTreeDefaultExpandDepth": 3
  },
  "profiles": {
    "java_fims": {
      "label": "Java — /fims/{module} (단일 레벨, 레거시)",
      "strategy": "split_after",
      "after": "/fims/",
      "segment_index": 0
    },
    "java_tree": {
      "label": "Java — com/**/ 패키지 이후 경로 트리 (롤업)",
      "strategy": "path_tree",
      "stripPrefixes": ["src/main/java/", "src/main/java"],
      "anchorAfter": "/fims/",
      "chartStackAnchorAfter": "/portal/",
      "maxDepth": 2
    },
    "vue_src_tree": {
      "label": "Vue — src/ 이후 경로 트리 (롤업)",
      "strategy": "path_tree",
      "stripPrefixes": ["src/"],
      "anchorAfter": "",
      "chartStackAnchorAfter": "",
      "maxDepth": 7
    }
  },
  "projectProfiles": {
    "api-server": "java_tree",
    "h1": "vue_src_tree",
    "h2": "vue_src_tree",
    "c1": "vue_src_tree"
  }
}
