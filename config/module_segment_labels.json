{
  "version": 1,
  "teamMapping": {
    "precedence": [
      {
        "teamId": "team_a",
        "label": "개발1팀",
        "when": {
          "modules": [
            "atm",
            "dashboard"
          ],
          "match": "any"
        }
      },
      {
        "teamId": "team_c",
        "label": "개발3팀",
        "when": {
          "modules": [
            "common",
            "person"
          ],
          "match": "any"
        }
      },
      {
        "teamId": "team_d",
        "label": "공통",
        "when": {
          "modules": [
            "com"
          ],
          "match": "any"
        }
      },
      {
        "teamId": "team_b",
        "label": "개발2팀",
        "when": {
          "modules": [
            "shrbatch"
          ],
          "match": "any"
        }
      }
    ],
    "fallback": {
      "teamId": "shared",
      "label": "ETC"
    },
    "_note": "HIGH RISK(BLOCKER+HIGH)만 팀 버킷 집계. 첫 매칭만 적용. path_tree: module_grouping.profiles.<id>.teamMatch.pathMustContain 이 있으면 해당 부분 문자열이 Sonar 상대 경로에 없을 때 팀 세그먼트 없음→ETC. teamMatch.maxDepth·stripPrefixes·anchorAfter 는 팀 매칭 전용 오버라이드. 앵커만 있는 레거시(java /fims/)는 앵커 미매칭 시 strip 폴백 없음."
  },
  "maps": {
    "java_tree": {
      "treeEnabled": true,
      "exclude": {
        "_note": "path_tree: strip·anchor 이후 rollup 기준. pathSegmentAny: 디렉터리 세그먼트(파일명 제외) 중 하나가 값과 같으면 제외. pathContains: 전체 문자열 부분일치",
        "pathPrefixes": [
          "generated"
        ],
        "pathContains": [
          "/mock/"
        ],
        "pathSegmentAny": [
          "dashboard"
        ],
        "firstSegments": [],
        "fileSuffixes": [
          "package-info.java"
        ]
      },
      "tree": {
        "portal": {
          "label": "포털",
          "children": {
            "common": {
              "label": "공통"
            },
            "domain": {
              "label": "업무영역"
            },
            "external": {
              "label": "외부 연동"
            }
          }
        },
        "atm": {
          "label": "ATM"
        }
      }
    },
    "vue_src_tree": {
      "treeEnabled": false,
      "_note": "src/ 제거 후 첫 세그먼트가 views·components·api 등 다양함. api만 두면 views/... 경로는 unknown. 접두 스킵 매칭(moduleSegmentLabels)으로 views/foo/api/common → api/common 도 라벨 가능",
      "exclude": {
        "_note": "src/ strip 후 상대 경로. pathSegmentAny 는 디렉터리 세그먼트(파일명 제외) 정확 일치",
        "pathPrefixes": [
          "assets"
        ],
        "pathContains": [
          "__mocks__",
          "Dockerfile"
        ],
        "pathSegmentAny": [],
        "firstSegments": [
          "public"
        ],
        "fileSuffixes": [
          ".stories.ts",
          ".stories.vue",
          ".spec.ts",
          ".test.ts"
        ]
      },
      "tree": {
        "views": {
          "label": "뷰"
        },
        "components": {
          "label": "컴포넌트"
        },
        "router": {
          "label": "라우터"
        },
        "assets": {
          "label": "에셋"
        },
        "api": {
          "label": "API",
          "children": {
            "common": {
              "label": "공통"
            },
            "domain": {
              "label": "업무영역"
            },
            "external": {
              "label": "외부 연동"
            }
          }
        }
      }
    }
  }
}
